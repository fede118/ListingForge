# Production env for the systemd unit. Copy to /etc/listingforge/listingforge.env
# on the host, fill in the three blanks, and chmod 0640 root:listingforge.
#
# This is NOT .env.example — that one documents local development and is loaded
# only by the Gradle `run` task, which does not exist on the server. systemd
# reads this file directly via EnvironmentFile. Values are literal: no quoting,
# no shell expansion, no inline comments after a value.

# --- secrets: fill these in, never commit them ---
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
# Generate with:  openssl rand -base64 48
SESSION_SIGN_KEY=

# --- identity of this deployment ---
# A HOSTNAME, never an IP: Etsy's app registration rejects IP-address callbacks
# outright ("Host must be a domain name"), though it does accept plain http.
# This name comes from the gateway registering DHCP client hostnames under .lan,
# so it depends on the host keeping both its hostname and a reserved lease.
# Must match the Etsy app registration byte-for-byte, including scheme and port.
ETSY_REDIRECT_URI=http://fedesrasp.lan:8080/auth/callback
# With no webpack dev server on the server, both allowlisted post-login redirect
# targets are this host, so the two origins are the same value here.
FRONTEND_ORIGIN=http://fedesrasp.lan:8080
BFF_ORIGIN=http://fedesrasp.lan:8080

# TEMPORARY: false only because this deployment is still plain http on the LAN.
# Set true the moment real HTTPS is in front of it — until then the session
# cookie travels unencrypted.
COOKIE_SECURE=false

OAUTH_SCOPES=shops_r listings_w listings_r
ANDROID_AUTH_DEEPLINK=listingforge://auth
SERVER_PORT=8080
APP_MODE=prod

# --- paths on the host, created by pi-bootstrap.sh ---
# Persistent storage, outside the deploy payload: holds the OAuth tokens and is
# the one thing here worth backing up.
DB_PATH=/var/lib/listingforge/db/listingforge.db
# The client repo's :webApp:wasmJsBrowserDistribution output, served same-origin.
WEBAPP_DIR=/opt/listingforge/webapp

# Netty plus SQLite sits far under this; the cap exists so a leak surfaces as a
# fast OOM instead of slowly starving the host.
JAVA_OPTS=-Xmx512m
