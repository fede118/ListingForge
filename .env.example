# Copy to .env and fill in. Load before running:  set -a; source .env; set +a
ETSY_KEYSTRING=your_keystring_here
ETSY_SHARED_SECRET=your_shared_secret_here
ETSY_REDIRECT_URI=http://localhost:8080/auth/callback
# Space-separated Etsy scope list. shops_r covers /api/me and /api/shop;
# listings_w is required for the Task 9 submit pipeline (create draft listing,
# upload image, upload file); listings_r is required for Task 12's browse-drafts
# read (getListingsByShop). A token already stored keeps its old scopes - after
# changing this, sign out (drops the stored token) and re-run /auth/login so
# the new consent screen requests the new scope and a fresh token is stored
# with it.
OAUTH_SCOPES=shops_r listings_w listings_r
# Any long random string; signs the session cookie so it can't be forged.
SESSION_SIGN_KEY=change_me_to_a_long_random_string
# Origin of the web client (the webpack dev server). Used for CORS AND as the
# default post-login redirect target - the BFF sends the browser back to
# whichever origin (this or BFF_ORIGIN below) it detected the /auth/login
# request as having come from, falling back to this value if neither matches.
FRONTEND_ORIGIN=http://localhost:3000
# This BFF's own origin, i.e. where a browser reaches it directly (matters when
# WEBAPP_DIR is set - see below - so the web app is served same-origin from
# here instead of the dev server). The other allowlisted post-login redirect
# target, alongside FRONTEND_ORIGIN. Defaults to http://localhost:$SERVER_PORT;
# override only if the BFF isn't reachable at plain localhost (e.g. behind a
# reverse proxy or a real domain).
# BFF_ORIGIN=http://localhost:8080
# Keep false on http localhost; set true once you're behind HTTPS.
COOKIE_SECURE=false
# Deep link the BFF redirects the Android app to after login (the session token
# rides as the `token` query parameter). The app must register this scheme.
ANDROID_AUTH_DEEPLINK=listingforge://auth
# Lifetime of an Android bearer session token, in seconds. Default 30 days.
SESSION_TOKEN_TTL_SECONDS=2592000
SERVER_PORT=8080
DB_PATH=listingforge.db
# Run profile: "prod" (default) talks to Etsy and enforces auth. "mock" runs a
# full fake sign-in flow - /auth/login serves a BFF-rendered stub consent page
# instead of redirecting to Etsy, and the token exchange returns a canned token
# for a fixed demo user - so it still needs completing before /api/* works, it
# just never touches Etsy or needs real credentials. Deploy a second instance
# with APP_MODE=mock (e.g. at mock.<domain>) and point the app at it to swap envs.
APP_MODE=prod
# Etsy endpoints. Defaults are the real production URLs; override only to point
# at a stub/sandbox host (e.g. in tests). Leave unset for normal use.
# ETSY_AUTHORIZE_URL=https://www.etsy.com/oauth/connect
# ETSY_TOKEN_URL=https://api.etsy.com/v3/public/oauth/token
# ETSY_API_BASE=https://api.etsy.com/v3/application
# Absolute path to the built wasmJS bundle (index.html, webApp.js, the .wasm
# binaries, Compose resources) - the output of the CLIENT repo's
# `./gradlew :webApp:wasmJsBrowserDistribution`, normally at
# webApp/build/dist/wasmJs/productionExecutable. Leave unset to run API-only
# (e.g. developing against the webpack dev server instead); when set, the BFF
# serves the app itself at "/", same-origin with the API. See README.md.
# WEBAPP_DIR=/path/to/webApp/build/dist/wasmJs/productionExecutable
